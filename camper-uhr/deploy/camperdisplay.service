[Unit]
Description=CamperDisplay backend (FastAPI)
After=network.target
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=simple
User=root
WorkingDirectory=/opt/camper-display/camper-uhr/backend
Environment=CAMPERDISPLAY_DATA_DIR=/var/lib/camperdisplay
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/camper-display/camper-uhr/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8080 --no-access-log
Restart=always
RestartSec=2
TimeoutStopSec=10
UMask=0027
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
